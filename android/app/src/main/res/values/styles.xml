<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Native launch theme (keep minimal & transparent) -->
    <style name="LaunchTheme" parent="@android:style/Theme.NoTitleBar">
        <!-- Pre-Android 12 -->
        <item name="android:windowBackground">@android:color/transparent</item>

        <!-- Android 12+ -->
        <item name="android:windowSplashScreenBackground">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimatedIcon">@null</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>

        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <!-- Applied AFTER Flutter loads -->
    <style name="NormalTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

</resources>
